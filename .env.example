# Copy to .env and fill in what you use. Keys can also be entered in the app (M ▸ Settings);
# a key set here takes precedence over one entered in the UI.

# Network: 0.0.0.0 makes Agora reachable from other devices on your LAN.
HOST=0.0.0.0
PORT=8080
# Where the SQLite database lives.
DATA_DIR=./data

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
# Any OpenAI-compatible server, e.g. Ollama: http://localhost:11434/v1
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
# Optional: private GitHub repositories and higher rate limits for Attach ▸ GitHub.
GITHUB_TOKEN=

# 1 = add offline "Mock" models that stream canned text (no keys needed).
MOCK_PROVIDER=0
